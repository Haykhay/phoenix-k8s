#!/usr/bin/env bash
# stage-module <module-dir> <cloud> <out-dir>
# Builds a runnable copy of a component for one cloud: the module's own files,
# then modules/_cloud/<cloud>/*.tf (backend, cloud provider), then the module's
# cloud/<cloud>/*.tf (its slice). Relative module sources ("../cluster") are
# rewritten to resolve from <out-dir>. Tests: scripts/tests/stage-module.test.sh
set -euo pipefail
[ $# -eq 3 ] || { echo "usage: stage-module <module-dir> <cloud> <out-dir>" >&2; exit 2; }
cloud=$2
case "$cloud" in aws|azure) ;; *) echo "unknown cloud: $cloud (aws|azure)" >&2; exit 2 ;; esac
module=$(cd "$1" && pwd -P)
root=$(cd "$(dirname "$0")/.." && pwd)
shared="$root/modules/_cloud/$cloud"
[ -d "$shared" ] || { echo "no $shared" >&2; exit 2; }

rm -rf "$3"; mkdir -p "$3"; out=$(cd "$3" && pwd -P)
# The module, without Terraform's working files or other clouds' slices.
(cd "$module" && tar -cf - --exclude ./.terraform --exclude ./.terraform.lock.hcl --exclude ./cloud .) | (cd "$out" && tar -xf -)
# Added files must never replace one of the module's: refuse a name clash.
add() {
  for f in "$@"; do
    [ -e "$out/$(basename "$f")" ] && { echo "$f would replace $(basename "$f") in the module" >&2; exit 1; }
    cp "$f" "$out/"
  done
}
add "$shared"/*.tf
if [ -d "$module/cloud/$cloud" ]; then add "$module/cloud/$cloud"/*.tf; fi

# A module has one required_providers block (Terraform allows no second):
# the cloud's provider entry goes into the module's own, in versions.tf.
grep -q '^  required_providers {$' "$out/versions.tf" || { echo "$module/versions.tf has no required_providers block" >&2; exit 1; }
awk -v entry="$shared/required_providers.hcl" '
  { print }
  /^  required_providers \{$/ { while ((getline line < entry) > 0) print line }
' "$out/versions.tf" > "$out/versions.tf.new" && mv "$out/versions.tf.new" "$out/versions.tf"

# "../x" in the module means <module's parent>/x; Terraform only accepts
# relative local sources, so point them at the same place from <out-dir>.
rel=$(python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$(dirname "$module")" "$out")
case "$rel" in .*) ;; *) rel="./$rel" ;; esac
for f in "$out"/*.tf; do
  sed -i.bak -E "s#(source[[:space:]]*=[[:space:]]*\")\.\./#\1$rel/#" "$f" && rm -f "$f.bak"
done
echo "$out"
