#!/usr/bin/env bash
# test-all: scripts/test-module over every module (not _boilerplate or _cloud).
# Last line: "--- modules: N failing: M".
set -uo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
n=0; failing=0
for d in "$root"/modules/*/; do
  case "$(basename "$d")" in _*) continue ;; esac
  n=$((n + 1))
  "$root/scripts/test-module" "$d" || failing=$((failing + 1))
done
echo "--- modules: $n failing: $failing"
[ "$failing" = 0 ]
